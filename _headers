# Apple refuses an association file that isn't served as JSON, and the file has no
# extension for a host to infer that from — this is the reason GitHub Pages can't host it.
/.well-known/apple-app-site-association
  Content-Type: application/json

# No extension on purpose: Cloudflare Pages' clean-URL handling redirects any *.html file to
# its extension-less form, and that redirect strips whatever the browser actually requested
# (/join/AB3XZ9 -> /join), which breaks the /join/* rewrite in _redirects. Serving this file
# without an extension keeps it out of that rewrite entirely — but it means the host can't
# infer the content type, so it has to be set explicitly here.
/join-landing
  Content-Type: text/html; charset=utf-8
